{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "security:minimumReleaseAgeNpm", "helpers:pinGitHubActionDigests"],
    "ignorePresets": ["group:monorepos", "group:recommended"],
    "labels": ["dependencies"],
    "automerge": false,
    "rangeStrategy": "bump",
    "dependencyDashboard": true,
    "prConcurrentLimit": 3,
    "prHourlyLimit": 2,
    "rebaseLabel": "renovate-regenerate",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "labels": ["dependencies", "vulnerability"]
    },
    "packageRules": [
        {
            "description": "Label major updates for careful review",
            "matchUpdateTypes": ["major"],
            "addLabels": ["help wanted"]
        },
        {
            "description": "Peer range changes need maintainer judgment",
            "matchDepTypes": ["peerDependencies"],
            "addLabels": ["help wanted"]
        },
        {
            "description": "TypeScript updates often need config migration",
            "matchPackageNames": ["typescript"],
            "addLabels": ["help wanted"]
        },
        {
            "description": "GitHub Actions: pinned to commit SHAs, updated weekly after a 3-day wait; the renovate/github-actions- branches skip Dependency Review",
            "matchManagers": ["github-actions"],
            "extends": ["schedule:weekly"],
            "minimumReleaseAge": "3 days",
            "additionalBranchPrefix": "github-actions-"
        }
    ]
}
